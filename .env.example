# Copy to `.env` (git-ignored) and edit. Values here are placeholders - never commit real secrets.
# Secrets can alternatively be supplied as files (Docker/Compose secrets): BOT_TOKEN_FILE=...

# --- identity ---------------------------------------------------------------------
# development | production. Production refuses to start with placeholder values and with the
# in-process (non-isolated) extractor.
APP_ENV=development
BOT_TOKEN=replace_me
# Comma-separated NUMERIC Telegram user ids (not usernames, not group ids).
ALLOWED_USER_IDS=123456789
# Only private chats are served. Must stay true in production.
PRIVATE_CHAT_ONLY=true

# --- Telegram API profile -----------------------------------------------------------
BOT_API_MODE=hosted
# Optional local mode, private network only. TELEGRAM_API_ID / TELEGRAM_API_HASH go to the local
# API service via secrets (see compose.yaml) and are never read by the bot.
LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# --- delivery / limits ----------------------------------------------------------------
DEFAULT_DELIVERY_MODE=media
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=1
MAX_QUEUE_SIZE=10
MAX_ITEMS_PER_JOB=30
EXTRACTION_TIMEOUT_SECONDS=120
UPLOAD_TIMEOUT_SECONDS=600
MAX_TEMP_BYTES_PER_JOB=4000000000
HOSTED_PHOTO_MAX_BYTES=9500000
HOSTED_FILE_MAX_BYTES=49000000
LOCAL_FILE_MAX_BYTES=1900000000
# Send HEVC/H.265 mp4 as a native video (otherwise it goes as a document in Media mode).
NATIVE_HEVC=false

# --- retention / cleanup --------------------------------------------------------------
JOB_METADATA_TTL_HOURS=24
ORPHAN_TTL_MINUTES=30
MIN_FREE_DISK_BYTES=1000000000

# --- retries / throttling -------------------------------------------------------------
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
STATUS_EDIT_MIN_INTERVAL_SECONDS=2

# --- paths ------------------------------------------------------------------------------
DATA_DIR=data
WORK_DIR=tmp/jobs
# Optional normal-session cookies file (Netscape format) for publicly shared Instagram Stories.
# Mounted into the EXTRACTOR WORKER only. Never send credentials through Telegram.
# INSTAGRAM_COOKIES_FILE=secrets/instagram_cookies.txt

# --- extractor worker boundary ----------------------------------------------------------
# inprocess = development only. remote = isolated worker service (production).
WORKER_MODE=inprocess
WORKER_URL=http://extractor-worker:8090
# Shared secret between bot and worker, >= 24 random characters. Prefer WORKER_SECRET_FILE.
WORKER_SECRET=replace_me
# WORKER_SECRET_FILE=/run/secrets/worker_secret
# Where the worker service listens (only reachable on the private compose network).
WORKER_HOST=0.0.0.0
WORKER_PORT=8090
# Egress allowlist proxy the extractors must use (compose wires this up).
# EGRESS_PROXY_URL=http://egress-proxy:3128
# Extra explicitly approved mobile/regional host variants as host=platform pairs.
# EXTRA_ALLOWED_HOSTS=

# --- operations ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Telegram long-poll timeout (seconds)
POLLING_TIMEOUT_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_MAX_AGE_SECONDS=90
# Optional owner alerts for repeated extractor failures / low disk. Never includes URLs.
ALERTS_ENABLED=false
ALERT_FAILURE_THRESHOLD=5
