# Copy to `.env` (git-ignored) and edit. Values here are placeholders - never commit real secrets.
# Runs natively on Windows (start-bot.bat / uv run python -m app.main) and Linux VPS (systemd).
# Secrets can alternatively be read from files (e.g. BOT_TOKEN_FILE=secrets/bot_token).

# --- identity ---------------------------------------------------------------------
# development | production. Production enforces a valid BOT_TOKEN, PRIVATE_CHAT_ONLY=true,
# and either ALLOWED_USER_IDS or PUBLIC_ACCESS=true. Works with WORKER_MODE=inprocess.
APP_ENV=development
BOT_TOKEN=replace_me
# BOT_TOKEN_FILE=secrets/bot_token
# Accept any Telegram user in their own private chat when enabled.
PUBLIC_ACCESS=false
# Comma-separated numeric Telegram user IDs. Optional for access when PUBLIC_ACCESS=true.
ALLOWED_USER_IDS=123456789
# Keep true in production and whenever public access is enabled.
PRIVATE_CHAT_ONLY=true

# --- Telegram API profile -----------------------------------------------------------
BOT_API_MODE=hosted
# Optional local Bot API server (loopback or private network only) for uploads > 50 MB.
LOCAL_BOT_API_URL=http://127.0.0.1:8081

# --- delivery / limits ----------------------------------------------------------------
DEFAULT_DELIVERY_MODE=media
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=1
MAX_QUEUE_SIZE=10
MAX_ITEMS_PER_JOB=30
EXTRACTION_TIMEOUT_SECONDS=120
UPLOAD_TIMEOUT_SECONDS=600
MAX_TEMP_BYTES_PER_JOB=4000000000
HOSTED_PHOTO_MAX_BYTES=9500000
HOSTED_FILE_MAX_BYTES=49000000
LOCAL_FILE_MAX_BYTES=1900000000
# Send 8-bit HEVC/H.265 mp4 as a native video directly (otherwise Media mode auto-transcodes it to H.264/AAC .mp4).
NATIVE_HEVC=false

# --- retention / cleanup --------------------------------------------------------------
JOB_METADATA_TTL_HOURS=24
ORPHAN_TTL_MINUTES=30
MIN_FREE_DISK_BYTES=1000000000

# --- retries / throttling -------------------------------------------------------------
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
STATUS_EDIT_MIN_INTERVAL_SECONDS=2

# --- paths ------------------------------------------------------------------------------
DATA_DIR=data
WORK_DIR=tmp/jobs
# Optional normal-session cookies file (Netscape format) for publicly shared Instagram Stories.
# Never send credentials through Telegram.
# INSTAGRAM_COOKIES_FILE=secrets/instagram_cookies.txt

# --- extractor worker boundary ----------------------------------------------------------
# inprocess = default single-process mode (works in development and production on Windows & Linux VPS).
# remote = optional separate worker service (`python -m app.extractors.service`).
WORKER_MODE=inprocess
WORKER_URL=http://127.0.0.1:8090
# Shared secret between bot and remote worker (>= 24 random characters). Only required when WORKER_MODE=remote.
WORKER_SECRET=replace_me
# WORKER_SECRET_FILE=secrets/worker_secret
# Where the optional worker service listens (loopback by default).
WORKER_HOST=127.0.0.1
WORKER_PORT=8090
# Optional allowlisting egress proxy (`python -m app.services.egress_proxy`, listens on 127.0.0.1:3128 by default).
# EGRESS_PROXY_URL=http://127.0.0.1:3128
# Egress proxy allowlist (comma-separated registrable suffixes). EMPTY = built-in TikTok/Instagram/X list.
# A non-empty value REPLACES that list, so include the built-in suffixes you still need. Never use a wildcard or a TLD.
# EGRESS_ALLOWED_SUFFIXES=
# Extra explicitly approved mobile/regional host variants as host=platform pairs.
# EXTRA_ALLOWED_HOSTS=

# --- operations ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Telegram long-poll timeout (seconds)
POLLING_TIMEOUT_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_MAX_AGE_SECONDS=90
# Optional owner alerts for repeated extractor failures / low disk. Never includes URLs.
ALERTS_ENABLED=false
ALERT_FAILURE_THRESHOLD=5
