# Keep the build context small and, above all, free of secrets and downloaded media.
.git
.gitignore
.githooks
.venv
.pytest_cache
.ruff_cache
**/__pycache__
**/*.pyc

# runtime state and secrets: never baked into an image
data
tmp
secrets
.env
.env.*
!.env.example
**/*.sqlite
**/*.sqlite3
cookies*.txt

# private live-test corpus and raw probe output
tests/live/corpus.txt
tests/live/corpus.*.txt
!tests/live/corpus.example.txt
ops/feasibility-raw
downloads

# local tooling
uv.lock
